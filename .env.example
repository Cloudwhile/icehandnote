# IceHandnote Environment Configuration Template
# Leave DATABASE_URL unset to use the built-in local file storage (DATA_DIR/store.json).
# Set DATABASE_URL only when connecting to an external PostgreSQL 17 (PGroonga) database.
# DATABASE_URL=postgres://icehandnote:icehandnote_secret@localhost:5432/icehandnote

API_HOST=127.0.0.1
API_PORT=3001

# Persistence Directories
DATA_DIR=./data
CONTENT_DIR=./content

CORS_ORIGIN=http://localhost:5173
DEFAULT_LOCALE=en

# Initial Admin Account Bootstrap
# If ADMIN_PASSWORD is set, creates/updates this admin account on startup.
# If omitted on first boot (when no admin exists), a random password is generated and printed in server logs.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@localhost
ADMIN_DISPLAY_NAME=Admin

# White-label Brand Defaults (can also be updated live in Studio -> Site Settings)
SITE_NAME=IceHandnote
SITE_BRAND_BADGE=
SITE_HERO_TITLE=IceHandnote
SITE_HERO_TAGLINE=Write clearly. Learn step by step.
SITE_FOOTER_TEXT=© IceHandnote · CC BY-NC-SA 4.0
SITE_AUTHOR_NAME=Author

# Optional: External Main Site Link & WordPress HMAC-SHA256 SSO Bridge
# BLOG_ORIGIN_URL=https://blog.example.com
# BLOG_NAV_LABEL=Main Site
# BLOG_SSO_QUERY_PARAM=sso_login
# Must match ICEHANDNOTE_SSO_SECRET in deploy/wordpress-sso-bridge.php (>= 32 random chars)
# BLOG_SSO_SECRET=replace-with-a-32-char-random-secret
# Optional: Enable remote WordPress Application Password verification
# BLOG_WP_API_URL=https://blog.example.com

# Local development flags only (always keep false in production)
DEV_SSO_SIMULATOR=false
SEED_DEMO_USERS=false
